generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_FAXvef5z2oLN@ep-lingering-poetry-ahaduz92-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require"
}

// Enums
enum Role {
  ADMIN
  SUPERVISOR
  APROVADOR     // Deprecated: Migrating to N2
  APROVADOR_N1  // New Level 1
  APROVADOR_N2  // New Level 2 (Final)
  FINANCEIRO
  ENCARREGADO
  RH
  DIARISTA
}

enum StatusPonto {
  EM_ANDAMENTO
  CONCLUIDO
}

enum StatusAntecipacao {
  PENDENTE
  APROVADO
  REPROVADO
  PAGO
}

enum StatusCobertura {
  PENDENTE
  AJUSTE
  APROVADO_N1   // Approved by Level 1, waiting for Level 2
  APROVADO      // Final approval (Level 2)
  REPROVADO
  PAGO
  CANCELADO
}

// Auth & Users
model User {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  password  String   // Simple auth for V1
  role      Role     @default(SUPERVISOR)
  ativo     Boolean  @default(true)
  acessoDespesas   Boolean  @default(true)
  acessoCoberturas Boolean  @default(true)
  avatarUrl        String?
  cargo            String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  // Relationships
  coberturasLancadas  Cobertura[] @relation("SupervisorLancamento")
  coberturasAprovadasN1 Cobertura[] @relation("AprovadorN1Acao")
  coberturasAprovadas Cobertura[] @relation("AprovadorAcao")
  coberturasPagas     Cobertura[] @relation("FinanceiroAcao")
  anexos              Anexo[]
  historico           HistoricoWorkflow[]
  
  postosAutorizados   Posto[]

  // Novas Relacoes para Despesas
  despesasSolicitadas   Despesa[] @relation("SolicitanteDespesa")
  despesasAprovadas     Despesa[] @relation("AprovadorDespesa")
  despesasPagas         Despesa[] @relation("FinanceiroDespesa")
  historicosDespesa     HistoricoDespesa[]

  // Centro de Custo Relacoes
  centroCustoId         String?
  centroCusto           CentroCusto? @relation("UserCentroCusto", fields: [centroCustoId], references: [id])
  centrosAprovadosN1    CentroCusto[] @relation("AprovadorN1Centro")
  centrosAprovadosN2    CentroCusto[] @relation("AprovadorN2Centro")
  centrosFinanceiro     CentroCusto[] @relation("FinanceiroCentro")
}

// Catalogs
model Posto {
  id         String   @id @default(uuid())
  nome       String
  latitude   Float?
  longitude  Float?
  raioMetros Int?     @default(200)
  ativo      Boolean  @default(true)
  coberturas Cobertura[]
  
  supervisores User[]
}

model Diarista {
  id           String      @id @default(uuid())
  nome         String
  cpf          String?     @unique // Added for uniqueness verification
  email        String?
  senha        String?
  telefone     String?
  chavePix     String? 
  ativo        Boolean     @default(true)
  coberturas   Cobertura[]
  pontos       RegistroPonto[]
  antecipacoes SolicitacaoAntecipacao[]
}

model Reserva {
  id    String  @id @default(uuid())
  nome  String  // Quem foi coberto (Banco de Reservas)
  cpf   String? @unique // Added for uniqueness verification
  ativo Boolean @default(true)
  coberturas Cobertura[]
}

model Motivo {
  id        String  @id @default(uuid())
  descricao String
  ativo     Boolean @default(true)
  coberturas Cobertura[]
}

model CargaHoraria {
  id        String  @id @default(uuid())
  descricao String  // Ex: 06:00, 08:00
  ativo     Boolean @default(true)
  coberturas Cobertura[]
}

model MeioPagamento {
  id        String  @id @default(uuid())
  descricao String  // PIX, Dinheiro, etc.
  ativo     Boolean @default(true)
  
  coberturasSolicitadas Cobertura[] @relation("MeioSolicitado")
  coberturasEfetivadas  Cobertura[] @relation("MeioEfetivado")
}

model Empresa {
  id         String          @id @default(uuid())
  nome       String
  cnpj       String?
  ativo      Boolean         @default(true)
  coberturas Cobertura[]
  faturas    FaturaCliente[]
  despesas   Despesa[]
  contaAzulConfig ContaAzulConfig?
}

model ContaAzulConfig {
  id                      String    @id @default(uuid())
  empresaId               String    @unique
  empresa                 Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  clientId                String?
  clientSecret            String?
  redirectUri             String?
  accessToken             String?
  refreshToken            String?
  expiresAt               DateTime?
  
  ativo                   Boolean   @default(true)
  autoCriarAoAprovar      Boolean   @default(true)
  
  // Categorias Mapeadas no Conta Azul
  categoriaDiariaId       String?
  categoriaDiariaNome     String?
  categoriaReembolsoId    String?
  categoriaReembolsoNome  String?
  categoriaAdiantamentoId String?
  categoriaAdiantamentoNome String?
  
  // Centros de Custo e Contas Financeiras Mapeadas
  centroCustoPadraoId     String?
  centroCustoPadraoNome   String?
  contaFinanceiraPadraoId String?
  contaFinanceiraPadraoNome String?
  
  webhookSecret           String?
  ultimaSincronizacao     DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model FaturaCliente {
  id                    String      @id @default(uuid())
  numeroFatura          String      @unique // Ex: FAT-2026-0001
  empresaId             String
  empresa               Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  valorDiarias          Decimal
  taxaServicoPercentual Float       @default(10.0)
  valorTaxaServico      Decimal
  valorTotal            Decimal
  
  status                String      @default("PAGA") // PAGA | PENDENTE | CANCELADA
  vencimentoEm          DateTime?
  observacoes           String?

  coberturas            Cobertura[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// Main Transaction
model Cobertura {
  id            String   @id @default(uuid())
  data          DateTime // Data da cobertura
  valor         Decimal  // Armazenado como Decimal, cuidado com SQLite (vai virar Float/String)
  observacao    String?
  
  // Status
  status        StatusCobertura @default(PENDENTE)
  
  // Relationships (FKs)
  postoId       String
  posto         Posto    @relation(fields: [postoId], references: [id])
  
  diaristaId    String
  diarista      Diarista @relation(fields: [diaristaId], references: [id])
  
  reservaId     String
  reserva       Reserva  @relation(fields: [reservaId], references: [id]) // Coberto
  
  motivoId      String
  motivo        Motivo   @relation(fields: [motivoId], references: [id])
  
  cargaHorariaId String
  cargaHoraria   CargaHoraria @relation(fields: [cargaHorariaId], references: [id])

  // Workflow User actors
  supervisorId  String
  supervisor    User     @relation("SupervisorLancamento", fields: [supervisorId], references: [id])
  
  // Approval Level 1
  aprovadorN1Id String?
  aprovadorN1   User?    @relation("AprovadorN1Acao", fields: [aprovadorN1Id], references: [id])
  dataAprovacaoN1 DateTime?

  // Approval Level 2 (Final) - Preserving old field for compatibility
  aprovadorId   String?
  aprovador     User?    @relation("AprovadorAcao", fields: [aprovadorId], references: [id])
  dataAprovacao DateTime?
  
  financeiroId  String?
  financeiro    User?    @relation("FinanceiroAcao", fields: [financeiroId], references: [id])
  dataPagamento DateTime?
  
  // Payment Details
  meioPagamentoSolicitadoId String
  meioPagamentoSolicitado   MeioPagamento @relation("MeioSolicitado", fields: [meioPagamentoSolicitadoId], references: [id])
  
  meioPagamentoEfetivadoId  String?
  meioPagamentoEfetivado    MeioPagamento? @relation("MeioEfetivado", fields: [meioPagamentoEfetivadoId], references: [id])

  empresaId     String?
  empresa       Empresa? @relation(fields: [empresaId], references: [id])

  // Workflow feedback loops
  ajusteSolicitado      String? // Texto do aprovador pedindo ajuste
  respostaAjuste        String? // Texto do supervisor respondendo
  justificativaReprovacao String? // Texto do aprovador ao reprovar
  justificativaPagamento  String? // Se meio efetivado != solicitado
  justificativaAprovacaoN1 String? // Parecer do Aprovador N1
  justificativaAprovacaoN2 String? // Parecer do Aprovador N2

  dataVencimento DateTime?
  createdAt     DateTime @default(now())
  horaInicio    String?
  horaFim       String?
  updatedAt     DateTime @updatedAt

  anexos        Anexo[]
  historico     HistoricoWorkflow[]
  ponto         RegistroPonto?
  antecipacoes  SolicitacaoAntecipacao[]

  faturado         Boolean        @default(false)
  faturaClienteId  String?
  faturaCliente    FaturaCliente? @relation(fields: [faturaClienteId], references: [id])
  dataFaturamento  DateTime?

  // Integração ERP Conta Azul
  contaAzulPayableId   String?
  contaAzulStatus      String?
  contaAzulSyncedAt    DateTime?
  contaAzulReceiptUrl  String?
}

// Evidence & Attachments
model Anexo {
  id          String   @id @default(uuid())
  url         String   // Path to file
  nomeOriginal String
  tamanho     Int      // Bytes
  tipo        String   // Mime type
  
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id])
  
  coberturaId String?   // Pode ser anexo de baixa (financeiro) ou lançamento (supervisor)
  cobertura   Cobertura? @relation(fields: [coberturaId], references: [id])
  
  despesaId   String?
  despesa     Despesa?   @relation("AnexosDespesa", fields: [despesaId], references: [id])
  
  auditUpload DateTime @default(now())
  // Se precisar de soft delete ou audit de remocao, adicionar flag ativo
  ativo       Boolean  @default(true)
}

// Audit Trail
model HistoricoWorkflow {
  id           String          @id @default(uuid())
  coberturaId  String
  cobertura    Cobertura       @relation(fields: [coberturaId], references: [id])
  
  deStatus     StatusCobertura?
  paraStatus   StatusCobertura
  
  usuarioId    String
  usuario      User            @relation(fields: [usuarioId], references: [id])
  
  data         DateTime        @default(now())
  observacao   String?         // Texto livre de log ou snapshot de alteracao
}

// Novos Enums e Modelos para Reembolso e Adiantamento (ReembolsaFácil)

enum TipoDespesa {
  REEMBOLSO
  ADIANTAMENTO
}

enum StatusDespesa {
  RASCUNHO
  AGUARDANDO_APROVACAO_N1
  AGUARDANDO_APROVACAO_N2
  AGUARDANDO_APROVACAO
  APROVADO
  REPROVADO
  PAGO
  AGUARDANDO_PRESTACAO
  AGUARDANDO_CONCILIACAO
  CONCLUIDO
}

model Despesa {
  id                    String            @id @default(uuid())
  tipo                  TipoDespesa
  status                StatusDespesa     @default(RASCUNHO)
  descricao             String
  valorSolicitado       Decimal           // Valor estimado (Adiantamento) ou Gasto (Reembolso)
  valorComprovado       Decimal?          // Preenchido na Prestação de Contas
  saldoFinal            Decimal?          // Calculado automaticamente (Solicitado vs Comprovado)
  alertaAuditoria       String?           // Armazena alertas gerados pelo motor de auditoria de termos proibidos
  
  // Atores do Fluxo
  solicitanteId         String
  solicitante           User              @relation("SolicitanteDespesa", fields: [solicitanteId], references: [id])
  
  aprovadorId           String?
  aprovador             User?             @relation("AprovadorDespesa", fields: [aprovadorId], references: [id])
  dataAprovacao         DateTime?
  justificativaAprovacao String?
  
  financeiroId          String?
  financeiro            User?             @relation("FinanceiroDespesa", fields: [financeiroId], references: [id])
  dataPagamento         DateTime?
  
  justificativaReprovacao String?
  observacao            String?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Centro de Custo
  centroCustoId         String?
  centroCusto           CentroCusto?      @relation(fields: [centroCustoId], references: [id])

  // Empresa do Grupo
  empresaId             String?
  empresa               Empresa?          @relation(fields: [empresaId], references: [id])

  // Integração ERP Conta Azul
  contaAzulPayableId    String?
  contaAzulStatus       String?
  contaAzulSyncedAt     DateTime?
  contaAzulReceiptUrl   String?

  // Relacionamentos modulares
  anexos                Anexo[]           @relation("AnexosDespesa")
  historico             HistoricoDespesa[]
  itens                 ItemDespesa[]
}

model HistoricoDespesa {
  id           String          @id @default(uuid())
  despesaId    String
  despesa      Despesa         @relation(fields: [despesaId], references: [id])
  
  deStatus     StatusDespesa?
  paraStatus   StatusDespesa
  
  usuarioId    String
  usuario      User            @relation(fields: [usuarioId], references: [id])
  
  data         DateTime        @default(now())
  observacao   String?
}

model PoliticaDespesa {
  id          String   @id @default(uuid())
  categoria   String   @unique // ex: REFEICAO, HOSPEDAGEM, TRANSPORTE
  descricao   String
  limiteValor Decimal
  ativo       Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ConfiguracaoAuditoria {
  id                      String   @id @default(uuid())
  palavrasProibidas        String   // CSV: "cerveja,energetico,preservativo,chiclete,bala,doce,bebida"
  motivosRejeicao         String   @default("Fora da política,Despesas não autorizada,Comprovante ilegível,Outros")
  taxaAntecipacaoPercentual Float   @default(5.0) // Taxa de antecipação padrão (%)
  taxaServicoClientePercentual Float @default(10.0) // Taxa de serviço/gestão cobrada do cliente (%)
  politicaVencimentoTipo   String   @default("TODA_SEXTA") // TODA_SEXTA | DIAS_APOS_DIARIA
  politicaVencimentoDias   Int      @default(7)
  logoPersonalizado        String?
  ativo                   Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model ItemDespesa {
  id            String   @id @default(uuid())
  despesaId     String
  despesa       Despesa  @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  
  categoria     String   // ex: REFEICAO, HOSPEDAGEM, TRANSPORTE
  descricao     String   // Descrição/Justificativa do item
  data          DateTime // Data do evento/ocorrência
  quantidade    Int      @default(1)
  valorUnitario Decimal
  valorTotal    Decimal
  createdAt     DateTime @default(now())
}

model CentroCusto {
  id             String    @id @default(uuid())
  nome           String    @unique
  ativo          Boolean   @default(true)
  
  // Aprovadores e Financeiro por Area
  aprovadorN1Id  String?
  aprovadorN1    User?     @relation("AprovadorN1Centro", fields: [aprovadorN1Id], references: [id])
  aprovadorN2Id  String?
  aprovadorN2    User?     @relation("AprovadorN2Centro", fields: [aprovadorN2Id], references: [id])
  financeiroId   String?
  financeiro     User?     @relation("FinanceiroCentro", fields: [financeiroId], references: [id])
  
  // Relações
  users          User[]    @relation("UserCentroCusto")
  despesas       Despesa[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model RegistroPonto {
  id           String      @id @default(uuid())
  coberturaId  String      @unique
  cobertura    Cobertura   @relation(fields: [coberturaId], references: [id], onDelete: Cascade)
  diaristaId   String
  diarista     Diarista    @relation(fields: [diaristaId], references: [id], onDelete: Cascade)
  
  checkInAt    DateTime    @default(now())
  checkInLat   Float?
  checkInLng   Float?
  checkInFoto  String?
  
  checkOutAt   DateTime?
  checkOutLat  Float?
  checkOutLng  Float?
  checkOutFoto String?
  
  status       StatusPonto @default(EM_ANDAMENTO)
  observacao   String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model SolicitacaoAntecipacao {
  id              String             @id @default(uuid())
  coberturaId     String
  cobertura       Cobertura          @relation(fields: [coberturaId], references: [id], onDelete: Cascade)
  diaristaId      String
  diarista        Diarista           @relation(fields: [diaristaId], references: [id], onDelete: Cascade)
  
  valorOriginal   Decimal
  valorSolicitado Decimal
  taxaServico     Decimal            @default(0)
  status          StatusAntecipacao  @default(PENDENTE)
  justificativa   String?
  
  solicitadoEm    DateTime           @default(now())
  aprovadoEm      DateTime?
  pagoEm          DateTime?
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

